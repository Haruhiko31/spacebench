# Copiez ce fichier en `.env` (dans pod-engine/) et adaptez les valeurs.
# Lu par app/core/settings.py via SettingsConfigDict(env_file=".env").
# En Docker, ces valeurs sont surchargees par le bloc `environment:` de docker-compose.yml.

# --- Mode ---
DEVELOPMENT=true

# --- PostgreSQL ---
# Doit pointer sur la meme base que le backend.
# localhost quand le pod-engine tourne sur la machine hote (run_the_app_dev.bat),
# spacebench-db quand il tourne dans Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spacebench

# --- Services ---
POD_ENGINE_URL=http://localhost:8002/pod

# --- Fichiers ---
UPLOAD_DIR=./uploads

# --- Debug ---
# Affiche tous les prints dans le terminal.
DEBUG_MODE=false
